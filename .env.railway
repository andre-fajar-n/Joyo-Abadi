# Railway Environment Variables Example
# These are automatically set by Railway, but shown here for reference

# Database (automatically provided by Railway PostgreSQL service)
# DATABASE_URL=postgresql://username:password@host:port/database

# Application
# PORT=3000 (automatically set by Railway)
# RAILWAY_ENVIRONMENT=production (automatically set by Railway)

# Optional - Set these in Railway dashboard if needed
LOG_LEVEL=info
ENV=production
